# Agent Exit testnet day. Copy to ~/.agent-exit.env (outside the repo) and
# fill in. Testnet only: anything else is refused. Values are never printed
# and never written to out/. `make verify` reads none of this (offline).
AGENT_EXIT_NETWORK=testnet

# The parent account; every demo account is a sub-account of it. Needs about
# 55 NEAR (testnet faucet). Its full-access key, ed25519:... (secret).
AGENT_EXIT_ROOT=agentexit.testnet
AGENT_EXIT_ROOT_KEY=

# NEAR RPCs (two providers for the scan). Known testnet hosts over https only.
AGENT_EXIT_RPC=https://rpc.testnet.near.org
AGENT_EXIT_RPC_2=https://test.rpc.fastnear.com

# Keys the runner creates (one file per account, mode 0600).
# AGENT_EXIT_KEYS_DIR=~/.agent-exit/keys

# Gate G6: NEAR AI Cloud (https://cloud.near.ai). Secret.
NEARAI_API_KEY=
# make llm-buyer fallback: ANTHROPIC_API_KEY=..., or point at another env file
# that already holds it (read at run time, never printed):
# ANTHROPIC_API_KEY_FROM=/mnt/c/path/to/.env#VAR_NAME
# NEARAI_MODEL=openai/gpt-oss-120b
# Second sample on another model, at least 6 h later (signer stability).
# NEARAI_MODEL_2=

# Gate G2: a Base Sepolia EOA with faucet ETH that relays the agent's
# transfer (pays the gas). 0x + 64 hex. Secret. Fund the agent's derived
# Base address (printed by make gate-g2) with Base Sepolia USDC from the
# Circle faucet.
BASE_RELAYER_KEY=
# BASE_SEPOLIA_RPC=https://sepolia.base.org
# Who the agent pays on Base (default: the relayer's own address).
# BASE_PAYEE=0x...
