# Copy to .env (gitignored). Testnet only; never put mainnet keys here.
# Nothing in `make verify` reads these: it runs fully offline.
NEAR_NETWORK=testnet
NEAR_RPC_URLS=https://test.rpc.fastnear.com,https://near-testnet.drpc.org
AGENT_ACCOUNT_ID=
SELLER_ACCOUNT_ID=
BUYER_ACCOUNT_ID=
XUSD_ACCOUNT_ID=
# Private keys are read from the environment only, e.g.:
# RUNNER_PRIVATE_KEY=ed25519:...
