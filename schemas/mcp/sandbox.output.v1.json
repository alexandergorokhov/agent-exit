{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-exit/mcp/sandbox.output.v1.json",
  "title": "sandbox output",
  "type": "object",
  "properties": {
    "schema_version": { "const": "agent-exit.mcp.sandbox.v1" },
    "network": { "type": "string" },
    "sandbox": { "const": true, "description": "in-memory only: nothing was sent to any chain" },
    "engine": { "type": "string", "description": "what ran: the wasm file and its sha256" },
    "step": { "type": "integer", "minimum": 0 },
    "action": { "type": "string" },
    "who": { "type": "string" },
    "ok": { "type": "boolean", "description": "false = the contract or the NEAR node refused it" },
    "result": { "type": "string", "description": "the contract's answer, with its error name when refused" },
    "state": { "type": "object", "description": "owner, status, keys on the account (and whether the contract knows them), listing, earnings, scan, sale, escrow, claimable balances, share slices, solvent (empty for help)" },
    "help": {
      "type": "object",
      "description": "action help only: every action (who acts, its optional args, what it does) and example sequences, from the server's action table",
      "required": ["actions", "examples"],
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["action", "who", "args", "does"],
            "properties": {
              "action": { "type": "string" },
              "who": { "type": "string" },
              "args": { "type": "object", "additionalProperties": { "type": "string" } },
              "does": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "examples": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["what", "steps"],
            "properties": {
              "what": { "type": "string" },
              "steps": { "type": "array", "items": { "type": "object", "required": ["action"], "properties": { "action": { "type": "string" } } } }
            },
            "additionalProperties": false
          }
        },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "network", "sandbox", "engine", "step", "action", "who", "ok", "result", "state"],
  "additionalProperties": false
}
