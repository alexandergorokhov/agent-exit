{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-exit/mcp/get_earnings.output.v1.json",
  "title": "get_earnings output",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "agent-exit.mcp.get_earnings.v1"
    },
    "network": {
      "type": "string",
      "enum": [
        "offline",
        "testnet"
      ]
    },
    "agent": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9._-]+$"
    },
    "earnings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gross",
        "counted",
        "verified",
        "flagged",
        "flagged_self",
        "flagged_seller_subaccount",
        "flagged_round_trip",
        "payments",
        "counted_payers",
        "days"
      ],
      "properties": {
        "gross": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "description": "xUSD-FAKE dollars, 2 decimals"
        },
        "counted": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "description": "xUSD-FAKE dollars, 2 decimals"
        },
        "verified": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "description": "xUSD-FAKE dollars, 2 decimals"
        },
        "flagged": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "description": "xUSD-FAKE dollars, 2 decimals"
        },
        "flagged_self": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "description": "xUSD-FAKE dollars, 2 decimals"
        },
        "flagged_seller_subaccount": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "description": "xUSD-FAKE dollars, 2 decimals"
        },
        "flagged_round_trip": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$",
          "description": "xUSD-FAKE dollars, 2 decimals"
        },
        "payments": {
          "type": "integer"
        },
        "counted_payers": {
          "type": "integer"
        },
        "days": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "day",
              "gross",
              "counted",
              "verified",
              "payments"
            ],
            "properties": {
              "day": {
                "type": "integer"
              },
              "gross": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]{2}$",
                "description": "xUSD-FAKE dollars, 2 decimals"
              },
              "counted": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]{2}$",
                "description": "xUSD-FAKE dollars, 2 decimals"
              },
              "verified": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]{2}$",
                "description": "xUSD-FAKE dollars, 2 decimals"
              },
              "payments": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "revenue_quality": {
      "type": "object",
      "additionalProperties": false,
      "description": "payer age and spread: how much of the counted revenue a buyer should trust (N3)",
      "required": [
        "days_of_history",
        "counted_payers",
        "avg_counted_per_payer",
        "from_new_payers_pct",
        "age_weighted_counted",
        "rule",
        "warnings"
      ],
      "properties": {
        "days_of_history": {
          "type": "integer",
          "minimum": 0
        },
        "counted_payers": {
          "type": "integer",
          "minimum": 0
        },
        "avg_counted_per_payer": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$"
        },
        "from_new_payers_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "age_weighted_counted": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$"
        },
        "rule": {
          "type": "string",
          "maxLength": 200
        },
        "warnings": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        }
      }
    },
    "meaning": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "network",
    "agent",
    "earnings",
    "meaning"
  ],
  "additionalProperties": false
}
