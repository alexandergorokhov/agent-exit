{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-exit/mcp/buy_agent.output.v1.json",
  "title": "buy_agent output",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "agent-exit.mcp.buy_agent.v1"
    },
    "network": {
      "type": "string",
      "enum": [
        "offline",
        "testnet"
      ]
    },
    "agent": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9._-]+$"
    },
    "buyer": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9._-]+$"
    },
    "seller": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9._-]+$"
    },
    "sale_id": {
      "type": "integer"
    },
    "price": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "description": "xUSD-FAKE dollars, 2 decimals"
    },
    "paid_now": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "description": "xUSD-FAKE dollars, 2 decimals"
    },
    "escrow": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "description": "xUSD-FAKE dollars, 2 decimals"
    },
    "overpay_refund": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "description": "xUSD-FAKE dollars, 2 decimals"
    },
    "listing_version": {
      "type": "integer"
    },
    "known_keys_hash": {
      "type": "string"
    },
    "scan_verdict": {
      "type": "string",
      "const": "clean"
    },
    "key_batch": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "key"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "delete",
              "add_fc",
              "add_full"
            ]
          },
          "key": {
            "type": "string"
          }
        }
      }
    },
    "owner_after": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9._-]+$"
    },
    "session_spent": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "description": "xUSD-FAKE dollars, 2 decimals"
    },
    "recorded": {
      "type": "boolean",
      "description": "true offline: the contract result was recorded from the real contract code, nothing was sent"
    }
  },
  "required": [
    "schema_version",
    "network",
    "agent",
    "buyer",
    "seller",
    "sale_id",
    "price",
    "paid_now",
    "escrow",
    "overpay_refund",
    "listing_version",
    "known_keys_hash",
    "scan_verdict",
    "key_batch",
    "owner_after",
    "session_spent",
    "recorded"
  ],
  "additionalProperties": false
}
