{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-exit/mcp/buy_agent.output.v1.json",
  "title": "buy_agent output",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "agent-exit.mcp.buy_agent.v1"
    },
    "network": {
      "type": "string",
      "enum": [
        "offline",
        "testnet"
      ]
    },
    "agent": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9._-]+$"
    },
    "buyer": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9._-]+$"
    },
    "seller": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9._-]+$"
    },
    "sale_id": {
      "type": "integer"
    },
    "price": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "description": "xUSD-FAKE dollars, 2 decimals"
    },
    "paid_now": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "description": "xUSD-FAKE dollars, 2 decimals"
    },
    "escrow": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "description": "xUSD-FAKE dollars, 2 decimals"
    },
    "overpay_refund": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "description": "xUSD-FAKE dollars, 2 decimals"
    },
    "listing_version": {
      "type": "integer"
    },
    "known_keys_hash": {
      "type": "string"
    },
    "scan_verdict": {
      "type": "string",
      "const": "clean"
    },
    "key_batch": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "key"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "delete",
              "add_fc",
              "add_full"
            ]
          },
          "key": {
            "type": "string"
          }
        }
      }
    },
    "owner_after": {
      "type": [
        "string",
        "null"
      ],
      "description": "null only when post_read_error is set",
      "maxLength": 64
    },
    "session_spent": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "description": "xUSD-FAKE dollars, 2 decimals"
    },
    "recorded": {
      "type": "boolean",
      "description": "true offline: the contract result was recorded from the real contract code, nothing was sent"
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "escrow_pct",
        "release_share_pct",
        "seller_floor_pct",
        "window_days"
      ],
      "properties": {
        "escrow_pct": {
          "type": "number"
        },
        "release_share_pct": {
          "type": "number"
        },
        "seller_floor_pct": {
          "type": "number"
        },
        "window_days": {
          "type": "number"
        }
      },
      "description": "the earn-out terms bought, from the same listing read as the price"
    },
    "terms_config": {
      "type": "string",
      "enum": [
        "prod",
        "demo"
      ],
      "description": "demo = the server accepts an earn-out window shorter than 30 days"
    },
    "sent": {
      "type": "boolean",
      "const": true,
      "description": "present (true) only when the buy was sent but something after it failed (L2); the spend stays counted"
    },
    "post_read_error": {
      "type": "string",
      "maxLength": 300,
      "description": "the read or check that failed after a sent buy; check the chain before retrying"
    },
    "tx_hash": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{43,44}$",
      "description": "Testnet: the buy transaction hash."
    },
    "explorer": {
      "type": "string",
      "pattern": "^https://testnet\\.nearblocks\\.io/txns/[1-9A-HJ-NP-Za-km-z]{43,44}$",
      "description": "Testnet: NearBlocks link of the buy."
    },
    "shares_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Share of every future payment already owed to investors (open slices); the buyer inherits it"
    },
    "warnings": {
      "type": "array",
      "description": "Non-blocking scan findings, e.g. shares_disclosed; chain text is untrusted",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "const": "warn"
          },
          "untrusted_detail": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "severity"
        ]
      }
    },
    "untrusted_notice": {
      "type": "string"
    },
    "sealed_config": {
      "type": "object",
      "description": "the listing sold a sealed config (prompt, tools, keys to rotate): its commitment and the one-time delivery key (the secret is only in delivery_key_file, mode 0600)",
      "properties": {
        "hash": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "delivery_pk": {
          "type": "string"
        },
        "delivery_key_file": {
          "type": "string"
        },
        "next": {
          "type": "string"
        }
      },
      "required": [
        "hash",
        "bytes",
        "delivery_pk",
        "delivery_key_file",
        "next"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "network",
    "agent",
    "buyer",
    "price",
    "session_spent",
    "recorded"
  ],
  "additionalProperties": false
}
