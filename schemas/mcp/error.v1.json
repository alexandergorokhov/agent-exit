{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-exit/mcp/error.v1.json",
  "title": "error returned by any tool (isError: true)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ok",
    "error"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "agent-exit.mcp.error.v1"
    },
    "ok": {
      "type": "boolean",
      "const": false
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "CONTRACT_REFUSED",
            "UNKNOWN_SALE",
            "NO_DELIVERY_KEY",
            "CONFIG_MATCHES",
            "CONFIG_MISMATCH",
            "NOT_DELIVERED",
            "WRITE_DISABLED",
            "CONFIRM_REQUIRED",
            "OVER_MAX_PRICE",
            "SHARES_OVER_MAX",
            "SESSION_CAP",
            "SCAN_BLOCKED",
            "TERMS_BELOW_MINIMUM",
            "SCAN_UNAVAILABLE",
            "NOT_LISTED",
            "NOT_OWNER",
            "UNKNOWN_AGENT",
            "UNKNOWN_ACCOUNT",
            "SANDBOX_UNAVAILABLE",
            "BAD_INPUT",
            "OFFLINE_NO_RECORDING",
            "NOT_BUILT",
            "NETWORK_REFUSED",
            "RPC_ERROR",
            "ALLOWANCE_LOW",
            "BUY_REFUSED",
            "SENT_UNCONFIRMED",
            "UNKNOWN_OFFER",
            "OFFER_CLOSED",
            "SHARE_TOO_SMALL",
            "NOT_BUYABLE",
            "SHARE_REFUSED",
            "UNDER_MIN_PRICE"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 400
        },
        "details": {}
      }
    },
    "sent": {
      "type": "boolean",
      "const": false,
      "description": "nothing was sent to any chain"
    }
  }
}
