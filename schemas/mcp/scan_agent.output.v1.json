{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-exit/mcp/scan_agent.output.v1.json",
  "title": "scan_agent output",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "agent-exit.mcp.scan_agent.v1"
    },
    "network": {
      "type": "string",
      "enum": [
        "offline",
        "testnet"
      ]
    },
    "agent": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9._-]+$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "clean",
        "blocked",
        "inconclusive"
      ]
    },
    "safe_to_buy": {
      "type": "boolean"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "block",
              "warn"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "buy_args": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "listing_version",
            "known_keys_hash"
          ],
          "additionalProperties": false,
          "properties": {
            "listing_version": {
              "type": "integer"
            },
            "known_keys_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "price": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              ],
              "description": "listing price in base units, from the scanned listing"
            }
          }
        }
      ]
    },
    "scanner": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "network",
    "agent",
    "verdict",
    "safe_to_buy",
    "findings",
    "buy_args",
    "scanner"
  ],
  "additionalProperties": false
}
