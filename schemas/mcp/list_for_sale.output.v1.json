{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-exit/mcp/list_for_sale.output.v1.json",
  "title": "list_for_sale output",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "agent-exit.mcp.list_for_sale.v1"
    },
    "network": {
      "type": "string",
      "enum": [
        "offline",
        "testnet"
      ]
    },
    "agent": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9._-]+$"
    },
    "seller": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9._-]+$"
    },
    "price": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "description": "xUSD-FAKE dollars, 2 decimals"
    },
    "paid_now": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "description": "xUSD-FAKE dollars, 2 decimals"
    },
    "escrow": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "description": "xUSD-FAKE dollars, 2 decimals"
    },
    "listing_version": {
      "type": "integer"
    },
    "known_keys_hash": {
      "type": "string"
    },
    "recorded": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "network",
    "agent",
    "seller",
    "price",
    "paid_now",
    "escrow",
    "listing_version",
    "known_keys_hash",
    "recorded"
  ],
  "additionalProperties": false
}
