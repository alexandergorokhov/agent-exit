{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-exit/mcp/list_agents.output.v1.json",
  "title": "list_agents output",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "agent-exit.mcp.list_agents.v1"
    },
    "network": {
      "type": "string",
      "enum": [
        "offline",
        "testnet"
      ]
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent",
          "owner",
          "status",
          "listing_version",
          "price",
          "gross",
          "counted",
          "verified",
          "flagged",
          "frozen"
        ],
        "properties": {
          "agent": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[a-z0-9._-]+$"
          },
          "owner": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[a-z0-9._-]+$"
          },
          "status": {
            "type": "string"
          },
          "listing_version": {
            "type": "integer",
            "minimum": 0
          },
          "price": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]{2}$",
                "description": "xUSD-FAKE dollars, 2 decimals"
              },
              {
                "type": "null"
              }
            ]
          },
          "gross": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "description": "xUSD-FAKE dollars, 2 decimals"
          },
          "counted": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "description": "xUSD-FAKE dollars, 2 decimals"
          },
          "verified": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "description": "xUSD-FAKE dollars, 2 decimals"
          },
          "flagged": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "description": "xUSD-FAKE dollars, 2 decimals"
          },
          "frozen": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "network",
    "agents"
  ],
  "additionalProperties": false
}
