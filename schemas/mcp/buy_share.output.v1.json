{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-exit/mcp/buy_share.output.v1.json",
  "title": "buy_share output",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "agent-exit.mcp.buy_share.v1"
    },
    "network": {
      "type": "string",
      "enum": [
        "offline",
        "testnet"
      ]
    },
    "agent": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9._-]+$"
    },
    "investor": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9._-]+$"
    },
    "offer_id": {
      "type": "integer"
    },
    "pct": {
      "type": "number"
    },
    "cost": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "description": "xUSD-FAKE dollars, 2 decimals"
    },
    "refund": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "description": "xUSD-FAKE dollars, 2 decimals"
    },
    "paid_to_owner_now": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "description": "xUSD-FAKE dollars, 2 decimals"
    },
    "held_in_escrow": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "description": "xUSD-FAKE dollars, 2 decimals"
    },
    "ends": {
      "type": "string"
    },
    "scan_verdict": {
      "type": "string",
      "const": "clean"
    },
    "session_spent": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "description": "xUSD-FAKE dollars, 2 decimals"
    },
    "recorded": {
      "type": "boolean"
    },
    "tx_hash": {
      "type": "string"
    },
    "explorer": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "network",
    "agent",
    "investor",
    "offer_id",
    "pct",
    "cost",
    "refund",
    "paid_to_owner_now",
    "held_in_escrow",
    "ends",
    "scan_verdict",
    "session_spent",
    "recorded"
  ],
  "additionalProperties": false
}
