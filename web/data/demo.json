  "steps": [
    {
      "id": "break-in",
      "title": "Break-in fails",
      "scenarios": [
        "A16",
        "A17",
        "A19",
        "A23",
        "A25"
      ],
      "story": "translator was sold to bob. alice, the old seller, tries every way back in. Each owner method refuses her with NotOwner. Her runner key was deleted in the sale's key batch, so on a real node a transaction signed with it is rejected before it reaches the contract (AccessKeyNotFound, sandbox test S5/A17). A key the contract never added (a planted backdoor) that calls the agent freezes it and returns the open escrow to the buyer.",
      "headline": [
        {
          "label": "old seller's calls refused",
          "value": "5/5"
        },
        {
          "label": "escrow back to buyer after the planted key",
          "value": "300.00"
        }
      ],
      "calls": [
        {
          "by": "alice.testnet",
          "call": "withdraw({amount: 1.00})",
          "outcome": "error",
          "error": "NotOwner"
        },
        {
          "by": "alice.testnet",
          "call": "set_runner_key(alice's new key)",
          "outcome": "error",
          "error": "NotOwner"
        },
        {
          "by": "alice.testnet",
          "call": "list_for_sale({price: 1.00})",
          "outcome": "error",
          "error": "NotOwner"
        },
        {
          "by": "alice.testnet",
          "call": "set_limits({...})",
          "outcome": "error",
          "error": "NotOwner"
        },
        {
          "by": "alice.testnet",
          "call": "nft_transfer({receiver: alice})",
          "outcome": "error",
          "error": "NotOwner"
        },
        {
          "by": "translator.testnet (hidden key)",
          "call": "heartbeat()",
          "outcome": "ok",
          "result": {
            "ok": false,
            "frozen": true,
            "backdoor_proven": {
              "signer_pk": "ed25519:5TeWSsjg2gbxCyWVniXeCmwM7UtHTCK7svzJr5xYJzHf",
              "returned": [
                {
                  "sale_id": 1,
                  "buyer": "bob.testnet",
                  "amount": "300000000"
                }
              ]
            }
          },
          "events": [
